NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application base URL used for patient-facing booking links
# e.g. https://app.example.com (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email delivery provider
# Supported values:
#   noop    — no-op provider (default; marks notifications as sent without sending)
#   console — prints email to stdout (development only)
#   resend  — Resend transactional email (production)
EMAIL_PROVIDER=noop

# Resend provider credentials (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Clinic <no-reply@example.com>

# AI provider selection
# Supported values:
#   openai    — OpenAI cloud (production; requires OPENAI_API_KEY)
#   anthropic — Anthropic Claude cloud (fast; requires ANTHROPIC_API_KEY)
#   ollama    — Local Ollama (zero-cost development/pilot; requires OLLAMA_MODEL)
# Default: openai. Ollama remains available as a fallback only.
AI_PROVIDER=anthropic

# OpenAI provider
# Required for AI receptionist features (chat, RAG retrieval, embeddings)
OPENAI_API_KEY=your-openai-api-key
# Optional: override the default model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional: override the embedding model (default: text-embedding-3-small)
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic Claude provider (recommended for fast, high-quality Arabic)
# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the default model.
# Fast latency target (<2-3s per reply): claude-haiku-4-5-20251001 (default)
# Deeper medical language quality (slightly slower): claude-sonnet-5
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama provider (local, zero-cost — EXPERIMENTAL FALLBACK ONLY)
# The installed local models (llama3.2:3b, qwen2.5:3b, qwen2.5:7b, qwen2.5-coder:3b)
# are NOT suitable for production conversational Arabic (repeated timeouts + poor output).
# Leave AI_PROVIDER=openai or anthropic for production. If you must test locally,
# set OLLAMA_MODEL to an installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Optional: secret to protect the cron endpoint from unauthorized invocation
# If set, the cron request must include: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=